# PostgreSQL / Supabase direct server connection
DATABASE_URL=

# Provider selection
MARKET_DATA_PROVIDER=marketstack
CRYPTO_DATA_PROVIDER=coingecko
FOREX_PROVIDER=frankfurter

# Server-only provider credentials
TWELVE_DATA_API_KEY=
MARKETSTACK_API_KEY=
COINGECKO_API_KEY=

# At least 16 random characters. Vercel sends this as Authorization: Bearer.
CRON_SECRET=

# Provider transport and free-tier cost controls
MARKET_DATA_BATCH_SIZE=8
MARKET_DATA_MAX_CONCURRENCY=2
MARKET_DATA_REQUEST_TIMEOUT_MS=8000
MARKET_DATA_MAX_RETRIES=2

# Central freshness thresholds
ASX_EXPECTED_DELAY_MINUTES=20
ASX_DELAY_TOLERANCE_MINUTES=10
ASX_STALE_AFTER_MINUTES=45
GENERAL_MARKET_STALE_AFTER_MINUTES=90
CRYPTO_FRESH_MINUTES=10
CRYPTO_STALE_MINUTES=20
FOREX_STALE_MINUTES=2160
EOD_STALE_AFTER_HOURS=96
FUNDAMENTALS_FRESH_HOURS=36
FUNDAMENTALS_STALE_HOURS=72

# Desired schedules. Vercel cron expressions remain in vercel.json; alternative
# schedulers should use these values when invoking the secured endpoints.
ASX_REFRESH_MINUTES=30
GLOBAL_INDICES_REFRESH_MINUTES=30
FOREX_REFRESH_MINUTES=60
CRYPTO_REFRESH_MINUTES=15
FUNDAMENTALS_REFRESH_HOURS=24
MARKET_STATUS_REFRESH_MINUTES=5

# Explicit local development only. Ignored in production even when true.
ENABLE_DEMO_MARKET_DATA=false
